# PF-10 candidate defaults. Never commit real credentials or private origins.
PORT=3000
ALLOWED_ORIGINS=https://OWNER.github.io
MAX_MESSAGE_BYTES=16384
MESSAGES_PER_SECOND=20
MAX_CONNECTIONS_PER_WINDOW=120
MAX_RECONNECTS_PER_WINDOW=20
CONNECTION_WINDOW_MS=60000
ROOM_TTL_MS=900000
CREDENTIAL_TTL_MS=900000
RESERVATION_TTL_MS=20000
METRICS_TTL_MS=3600000
DISCONNECT_GRACE_MS=60000
RACE_DURATION_SECONDS=180
